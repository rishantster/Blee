package __BLEE_APP_PACKAGE__;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;

public class BleeBootReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        if (Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction()) || Intent.ACTION_MY_PACKAGE_REPLACED.equals(intent.getAction())) {
            try {
                BleeMeshDb db = new BleeMeshDb(context);
                String wallet = db.activeWallet();
                db.close();
                if (wallet != null && !wallet.isEmpty()) BleeMeshService.start(context);
            } catch (Throwable ignored) {}
        }
    }
}
